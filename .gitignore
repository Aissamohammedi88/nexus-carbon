# Build and Release Folders
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/

# Other files and folders
.settings/

# Executables
*.swf
*.air
*.ipa
*.apk

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.
# ═══════════════════════════════════════════════════════════════════
# NEXUS CARBON — Enterprise Multi-Language .gitignore
# ═══════════════════════════════════════════════════════════════════

# --- SYSTÈME D'EXPLOITATION & ÉDITEURS ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
.vs/
*.sublime-workspace

# --- PYTHON (Orchestration & Scripts) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# --- RUST (Core Engine) ---
target/
**/*.rs.bk
Cargo.lock
*.pdb

# --- C++ (Performance Modules) ---
build/
cmake-build-*/
*.o
*.obj
*.exe
*.out
*.app
*.dll
*.so
*.dylib
CMakeCache.txt
CMakeFiles/
Makefile
compile_commands.json

# --- NODE.JS / TYPESCRIPT (Frontend / WebUI) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
.next/
out/
.nuxt/
.cache/

# --- SÉCURITÉ & SOUVERAINETÉ ---
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
secrets.json
config.local.json

# --- ARTEFACTS DE COMPILATION & BENCHMARKS ---
*.log
logs/
tmp/
temp/
*.tar.xz
*.tar.gz
*.zip
nexus-carbon

# --- BASES DE DONNÉES LOCALES ---
*.db
*.sqlite3
*.sqlite
